    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get current item from AI node\nconst item = $json;\n\n// Get original merged data from 2 nodes back\nconst mergeData = $('Merge').item.json;\n\n// ── Extract AI text ───────────────────────────────────────────────────────\nlet raw = '';\nif (item.candidates?.[0]?.content?.parts?.[0]?.text) {\n  raw = item.candidates[0].content.parts[0].text;\n} else if (item.message?.content) {\n  raw = item.message.content;\n} else if (item.text) {\n  raw = item.text;\n}\n\n// ── Clean and parse JSON ──────────────────────────────────────────────────\nconst cleaned = raw.replace(/```json\\s*/gi, '').replace(/```\\s*/gi, '').trim();\nlet parsed = {};\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e1) {\n  const firstBrace = cleaned.indexOf('{');\n  const lastBrace = cleaned.lastIndexOf('}');\n  if (firstBrace !== -1 && lastBrace !== -1) {\n    try {\n      parsed = JSON.parse(cleaned.slice(firstBrace, lastBrace + 1));\n    } catch (e2) {\n      parsed = {\n        match_score: 0,\n        matchedSkills: [],\n        missingSkills: [],\n        recommendation: 'review',\n        reason: 'Could not parse AI response',\n        improve: 'No suggestions available due to parsing error.'\n      };\n    }\n  }\n}\n\n// ── Pull candidate + job from Merge node ──────────────────────────────────\nconst candidateId = mergeData.candidate_id;\nconst candidateScore = mergeData.input1?.overall_score || mergeData.overall_score || '';\nconst candidateName = mergeData.input1?.name || mergeData.name || '';\nconst candidateEmail = mergeData.input1?.email || mergeData.email || '';\nconst candidateStatus = mergeData.input1?.status || mergeData.status || '';\n\nconst jobId = mergeData.jobId || '';\nconst jobTitle = mergeData.title || '';\n\n// ── Return final result ───────────────────────────────────────────────────\nreturn {\n  json: {\n    // AI scores\n    matchScore: parsed.match_score ?? 0,\n    matchedSkills: parsed.matchedSkills ?? [],\n    missingSkills: parsed.missingSkills ?? [],\n    recommendation: parsed.recommendation ?? 'review',\n    reason: parsed.reason ?? '',\n    improve: parsed.improve ?? '',\n\n    // Candidate info\n    candidate_id: candidateId,\n    overall_score: candidateScore,\n    name: parsed.extracted_name || candidateName || 'Unknown Candidate', \n    email: parsed.extracted_email || candidateEmail || 'no-email@example.com',\n    phone: parsed.extracted_phone || 'N/A',\n    status: candidateStatus,\n    experience: parsed.experience || '',\n\n    // Job info\n    job_id: jobId,\n    job_title: jobTitle,\n    processed_at: new Date().toISOString(),\n  }\n};"
      },
